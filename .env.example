# Credenciales obligatorias (Discord Developer Portal)
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Dashboard web (obligatorias)
# Genera un secreto largo y aleatorio de al menos 32 caracteres.
DASHBOARD_SESSION_SECRET=
DASHBOARD_ADMIN_USERNAME=Linox
# Configura esta contraseña solo en Railway; no la subas a GitHub.
DASHBOARD_ADMIN_PASSWORD=
# Railway asigna PORT automáticamente.
PORT=3000
# En Railway, crea un volumen montado en /data.
DATA_DIR=/data
# Railway se detecta automáticamente. En otro proveedor con un único proxy HTTPS usa true.
TRUST_PROXY=false
# Opcional si el proxy cambia Host; usa solo el origen público, sin ruta final.
DASHBOARD_PUBLIC_ORIGIN=

# Acceso de comandos Discord
COMMAND_ROLE_ID=1523180563723190394

# Tickets iniciales (después se administran desde el dashboard)
TICKET_CATEGORY_ID=
SUPPORT_ROLE_ID=
LOG_CHANNEL_ID=

# Presencia de streaming
STREAM_NAME=BLL $ LIFE
STREAM_URL=https://www.twitch.tv/blllife

# Anti-raid inicial (después se administra desde el dashboard)
ANTIRAID_ENABLED=true
ANTIRAID_ACTION=ban
TRUSTED_USER_IDS=
JOIN_THRESHOLD=8
JOIN_WINDOW_SECONDS=10
RAID_MODE_MINUTES=10
MIN_ACCOUNT_AGE_HOURS=24
MASS_MENTION_THRESHOLD=5
SPAM_MESSAGE_THRESHOLD=7
SPAM_WINDOW_SECONDS=5
DESTRUCTIVE_THRESHOLD=3
DESTRUCTIVE_WINDOW_SECONDS=10
TIMEOUT_MINUTES=60
